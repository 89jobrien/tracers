/target
Cargo.lock

# trace:: checkpoint files (generated at runtime)
*.trace.json

# atelier / ctx — generated, not committed (except HANDOFF yaml)
.ctx/*
!.ctx/HANDOFF.*.yaml
.ctx/HANDOFF.*.state.yaml

# handoff-begin
.ctx/*
!.ctx/HANDOFF.*.yaml
.ctx/HANDOFF.godmode.*.yaml
.ctx/HANDOFF.*.state.json
!.ctx/handoff.*.config.toml.example
.ctx/HANDOFF.*.*.state.json
.ctx/HANDOFF.hj.hj.state.json
.ctx/.initialized
# handoff-end
